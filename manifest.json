{
  "manifest_version": 3,
  "key": "",
  "name": "Dictat en català",
  "version": "1.1.0",
  "description": "Dictat de veu en català a la pestanya activa mitjançant la Web Speech API de Chrome, amb un diccionari de correccions entrenat amb la teva veu. Sense servidors propis.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Iniciar/aturar dictat (Ctrl+Space)"
  },
  "options_ui": {
    "page": "training.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "linux": "Ctrl+Space"
      },
      "description": "Iniciar o aturar el dictat al camp de text actiu"
    },
    "open-training": {
      "description": "Obrir l'entrenament de pronunciació"
    }
  }
}
